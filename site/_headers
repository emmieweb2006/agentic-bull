/*.json
  Access-Control-Allow-Origin: *
  Content-Type: application/json; charset=utf-8

/*.txt
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8

/.well-known/*
  Access-Control-Allow-Origin: *
  Content-Type: application/json; charset=utf-8

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
